{
  "name": "@cuongph.dev/mcp-jira",
  "version": "0.1.15",
  "description": "MCP server for internal Jira 8 via HTTP Basic Auth",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "jira-mcp": "dist/server.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/server.ts",
