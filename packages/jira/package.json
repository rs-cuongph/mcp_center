    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "axios": "^1.7.7",
    "dayjs": "^1.11.20",
    "dotenv": "^16.4.5",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cuongph.dev/mcp-core": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/unist": "^3.0.3"
  }
}
