{
  "name": "@cuongph.dev/mcp-backlog",
  "version": "0.1.7",
  "description": "MCP server for Backlog (Nulab) — read issues, comments, attachments via API Key",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "backlog-mcp": "dist/server.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "axios": "^1.7.7",
    "dayjs": "^1.11.20",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cuongph.dev/mcp-core": "workspace:*"
  }
}
