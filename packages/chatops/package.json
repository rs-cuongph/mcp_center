{
  "name": "@cuongph.dev/mcp-chatops",
  "version": "0.1.5",
  "description": "MCP server for ChatOps — SSO session auth via Playwright, read/send messages",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "chatops-mcp": "dist/server.js",
    "chatops-auth-login": "dist/cli/auth-login.js",
    "chatops-auth-check": "dist/cli/auth-check.js",
    "chatops-auth-clear": "dist/cli/auth-clear.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.1",
    "playwright": "^1.48.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cuongph.dev/mcp-core": "workspace:*",
    "@cuongph.dev/mcp-auth-playwright": "workspace:*"
  }
}
